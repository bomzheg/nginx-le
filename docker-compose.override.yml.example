# Per-machine configuration. Copy to docker-compose.override.yml (gitignored,
# compose merges it automatically) on the machine that acts as the front proxy.
#
# It carries the two things that must never be committed or published: which vhost
# file this machine plays, and the origin's address.
#
#   front proxy .env:  LE_FQDN=hestia.bomzheg.dev,shvatka.bomzheg.dev,shvatka-test.bomzheg.dev
#   origin .env:       LE_FQDN=nemesis.bomzheg.dev
#
# The two lists must not overlap: one certificate request covers every domain in
# LE_FQDN, so a single unreachable domain fails the whole request. The origin only
# ever issues for names that resolve to it, which is why the internal name below
# is absent from both lists — it is not public and cannot be validated.

version: '2'
services:
    nginx:
        volumes:
            - ./conf/nginx.conf:/etc/nginx/nginx.conf
            - ./etc/ssl:/etc/nginx/ssl
            - ./etc/bots/:/etc/nginx/bots/
            - ./etc/acme.conf:/etc/nginx/acme.conf
            - ./etc/services-hestia.conf:/etc/nginx/service.conf
            - ./www/html/:/usr/www/html/

        # The origin's address lives here and nowhere else — no DNS record, nothing
        # in git. Replace 203.0.113.10 with the real one. Compose replaces this list
        # rather than appending to it, so the host-gateway entry is repeated.
        extra_hosts:
          - "nemesis.internal:203.0.113.10"
          - "host.docker.internal:host-gateway"
